                    <li><a href="#" class="text-gray-600 hover:text-green-600 transition-colors">品牌合作</a></li>
                    <li><a href="#" class="text-gray-600 hover:text-green-600 transition-colors">API授权</a></li>
                    <li><a href="#" class="text-gray-600 hover:text-green-600 transition-colors">媒体报道</a></li>
                </ul>
            </div>
            
            <!-- 关注我们 -->
            <div>
                <h3 class="text-lg font-semibold mb-4 text-gray-800">关注我们</h3>
                <div class="flex space-x-4 mb-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-800 hover:bg-green-600 hover:text-white transition-colors">
                        <i class="fa fa-weixin"></i>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-800 hover:bg-green-600 hover:text-white transition-colors">
                        <i class="fa fa-weibo"></i>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-800 hover:bg-green-600 hover:text-white transition-colors">
                        <i class="fa fa-qq"></i>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-800 hover:bg-green-600 hover:text-white transition-colors">
                        <i class="fa fa-envelope"></i>
                    </a>
                </div>
                <p class="text-gray-600">客服热线: 400-123-4567</p>
                <p class="text-gray-600">工作时间: 9:00-18:00</p>
