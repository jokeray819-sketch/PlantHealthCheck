    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        
        // Create preview URL
        var imageStream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var buffer = new byte[selectedFile.Size];
        await imageStream.ReadAsync(buffer);
        var base64 = Convert.ToBase64String(buffer);
        previewImageUrl = $"data:{selectedFile.ContentType};base64,{base64}";
        
        StateHasChanged();
    }

    private async Task TakePhoto()
    {
        await JSRuntime.InvokeVoidAsync("alert", "拍照功能需要访问您的摄像头，在实际应用中将调用设备相机");
    }

    private async Task StartDetection()
    {
        if (string.IsNullOrEmpty(previewImageUrl))
        {
            await JSRuntime.InvokeVoidAsync("alert", "请先上传或拍摄植物照片");
            return;
        }

        isDetecting = true;
        StateHasChanged();

        // Simulate detection process
        await Task.Delay(2000);

        showDetectionResult = true;
        isDetecting = false;
        StateHasChanged();

        // Initialize chart
        await JSRuntime.InvokeVoidAsync("initHealthScoreChart");
    }

    private async Task AddPlant()
    {
        await JSRuntime.InvokeVoidAsync("alert", "添加植物功能即将上线，敬请期待！");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Add smooth scroll behavior
            await JSRuntime.InvokeVoidAsync("eval", @"
                document.querySelectorAll('a[href^=""#""]').forEach(anchor => {
                    anchor.addEventListener('click', function(e) {
                        e.preventDefault();
                        const targetId = this.getAttribute('href');
                        const targetElement = document.querySelector(targetId);
                        if (targetElement) {
                            window.scrollTo({
                                top: targetElement.offsetTop - 80,
                                behavior: 'smooth'
                            });
                        }
                    });
                });
            ");

            // Add Chart.js initialization function
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.initHealthScoreChart = function() {
                    const ctx = document.getElementById('health-score-chart');
                    if (ctx) {
                        const score = 85;
                        new Chart(ctx, {
                            type: 'doughnut',
                            data: {
                                datasets: [{
                                    data: [score, 100 - score],
                                    backgroundColor: ['#4CAF50', '#E0E0E0'],
                                    borderWidth: 0,
                                    cutout: '80%'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: true,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: { enabled: false }
                                }
                            }
                        });
                    }
                }
            ");
        }
    }

